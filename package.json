{
  "name": "tranx",
  "private": true,
  "version": "2.1.0",
  "description": "Penerjemah lintas perangkat teks, gambar, dokumen, dan tautan berbahasa Jepang ke bahasa Indonesia atau Inggris berbasis jptrans 1.1.0 dan Firebase Gen-2.",
  "scripts": {
    "vendor:jptrans": "python3 -B tools/vendor_jptrans.py",
    "verify:integrity": "python3 -B tools/verify_integrity.py",
    "test:backend": "functions/venv/bin/python3.12 -B -m pytest functions/tests -v",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "test:e2e": "npm run test:e2e --prefix web",
    "deploy": "firebase deploy --project tranx-hanif-id"
  }
}
