rules_version = '2';

// Cloud Storage security rules for tranX (single-owner 50 MB upload gate + read-only output artifacts).
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (
          (
            'email' in request.auth.token
            && request.auth.token.email == 'hanifp633@gmail.com'
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true
          )
          || (
            'owner' in request.auth.token
            && request.auth.token.owner == true
          )
        );
    }

    match /uploads/{uid}/{jobId}/{fileName} {
      allow read, delete: if isOwner() && request.auth.uid == uid;
      allow create, update: if isOwner()
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;
    }

    match /outputs/{uid}/{jobId}/{fileName} {
      allow read: if isOwner() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
